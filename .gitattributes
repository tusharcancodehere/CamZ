# Set default behavior to automatic text conversion with LF line endings
* text=auto eol=lf

# Explicitly ensure shell scripts use LF line endings
*.sh text eol=lf
camz text eol=lf

# Ensure Windows PowerShell scripts use CRLF line endings
*.ps1 text eol=crlf

# Documentation & configuration
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary media files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg binary
*.mp4 binary
*.avi binary
